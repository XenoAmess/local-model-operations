{
  "schema": "local-model-operations.executor/v1",
  "base_url": "http://192.168.1.11:8080/v1",
  "model": "qwen38-coder",
  "authentication": {
    "required": false,
    "api_key_env": "LOCAL_MODEL_API_KEY",
    "client_required_placeholder": "local"
  },
  "automatic_fallback": false,
  "client_maintenance": {
    "opencode": {
      "package": "opencode-ai",
      "channel": "latest",
      "minimum_version": "1.18.31",
      "command_timeout_seconds": 30,
      "update_timeout_seconds": 300,
      "lock_timeout_seconds": 420
    }
  },
  "defaults": {
    "temperature": 0,
    "chat_template_kwargs": {
      "enable_thinking": false
    },
    "response_format": {
      "type": "json_object"
    }
  },
  "prompting": {
    "layout_version": "stable-prefix-v1",
    "system_template": "You are a Java engineering collaborator. Use only the supplied current source and contracts. Return a precise candidate or analysis for the final task. Do not invent APIs, missing facts, successful tests, or game outcomes. Distinguish observations from assumptions. Follow the requested output format."
  },
  "timeouts": {
    "read_seconds": 180,
    "total_seconds": 900
  },
  "transient_retries": {
    "maximum_attempts": 6,
    "backoff_seconds": [
      10,
      20,
      40,
      60,
      60
    ],
    "jitter_ratio": 0.2,
    "retry_http_statuses": [
      429,
      502,
      503,
      504
    ],
    "retry_transport_errors": [
      "connection_refused",
      "connection_reset",
      "connect_timeout",
      "read_timeout",
      "incomplete_response"
    ],
    "scope": "model HTTP requests only; never replay downstream business actions",
    "on_partial_stream": "retain failed attempt, discard candidate, retry the complete unchanged request"
  },
  "network": {
    "proxy_mode": "direct",
    "direct_host": "192.168.1.11"
  }
}
