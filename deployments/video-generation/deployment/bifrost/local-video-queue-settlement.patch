+var localQueueVideoID = regexp.MustCompile(`^video_gen_[0-9a-f]{32}:openai$`)
+
+func localVideoQueueManaged(job *tables.TableProviderJob) bool {
+	if job.Provider != string(schemas.OpenAI) || !localQueueVideoID.MatchString(job.JobID) {
+		return false
+	}
+	return (job.Model == "fasth3-omni-bf16" || job.Model == "open-h3-2k") &&
+		os.Getenv("BIFROST_LOCAL_VIDEO_QUEUE_SETTLEMENT") == "true"
+}
