+func TestRecordVideoJobLifecycle_LocalQueueDefersOnlyActiveLocalVideos(t *testing.T) {
+	const queueID = "video_gen_0123456789abcdef0123456789abcdef:openai"
+	for _, tc := range []struct {
+		name, env, provider, model, videoID string
+		status                              schemas.VideoStatus
+		due                                 bool
+	}{
+		{"queued Omni", "true", "openai", "fasth3-omni-bf16", queueID, schemas.VideoStatusQueued, false},
+		{"running IC", "true", "openai", "open-h3-2k", queueID, schemas.VideoStatusInProgress, false},
+		{"completed local", "true", "openai", "open-h3-2k", queueID, schemas.VideoStatusCompleted, true},
+		{"disabled", "", "openai", "open-h3-2k", queueID, schemas.VideoStatusQueued, true},
+		{"other model", "true", "openai", "sora-2", queueID, schemas.VideoStatusQueued, true},
+		{"other provider", "true", "another", "open-h3-2k", queueID, schemas.VideoStatusQueued, true},
+		{"other ID", "true", "openai", "open-h3-2k", "provider-video-id", schemas.VideoStatusQueued, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("BIFROST_LOCAL_VIDEO_QUEUE_SETTLEMENT", tc.env)
+			plugin, store := newVideoLifecyclePlugin(t)
+			entry := &logstore.Log{ID: "submit-log", Provider: tc.provider, Model: tc.model}
+			result := &schemas.BifrostResponse{
+				VideoGenerationResponse: &schemas.BifrostVideoGenerationResponse{ID: tc.videoID, Status: tc.status},
+			}
+			plugin.recordVideoJobLifecycle(entry, result, schemas.VideoGenerationRequest)
+			jobID := cstables.ProviderJobID(cstables.ProviderJobKindVideo, tc.provider, tc.videoID)
+			job, err := store.GetProviderJob(context.Background(), jobID)
+			if err != nil || job == nil {
+				t.Fatalf("job persistence failed: %v", err)
+			}
+			if (job.NextCheckAt != nil) != tc.due {
+				t.Fatalf("scheduled to poll = %t, want %t", job.NextCheckAt != nil, tc.due)
+			}
+		})
+	}
+}
+
 // The request is the only witness to duration and resolution for most providers,
 // and it is in hand exactly once — here. If it is not written down now, settlement
 // minutes later has nothing to price from.
