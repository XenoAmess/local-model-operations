[Unit]
Description=Independent LAN video service status during upgrades
After=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/ubuntu/workspace/xenoamess_bake_videos
ExecStart=/usr/bin/python3 /home/ubuntu/workspace/xenoamess_bake_videos/tools/serve_video_status.py
MemoryMax=128M
MemorySwapMax=0
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
UMask=0077

[Install]
WantedBy=default.target
