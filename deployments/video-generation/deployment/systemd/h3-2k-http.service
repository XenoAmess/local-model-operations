[Unit]
Description=Local full H3 and IC 2K sequential HTTP service
After=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/ubuntu/workspace/xenoamess_bake_videos
ExecStart=/home/ubuntu/workspace/xenoamess_bake_videos/start-h3-2k-http.sh
ExecStopPost=-/usr/bin/systemctl --user stop llmlab-h3-2k-job-*.service
MemoryMax=1G
MemorySwapMax=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
