[Unit]
Description=Batch local video status and schedule terminal Bifrost settlement
After=bifrost-lan.service
Requisite=bifrost-lan.service

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/xenoamess_bake_videos
ExecStart=/usr/bin/python3 %h/workspace/xenoamess_bake_videos/tools/settle_queued_videos.py --apply
TimeoutStartSec=25s
MemoryMax=64M
MemorySwapMax=0
UMask=0077
