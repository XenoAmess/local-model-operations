[Unit]
Description=FastH3 Omni BF16 reference video and audio internal GPU worker
After=network-online.target llmlab-guard.service
Conflicts=fasth3-omni.service h3-2k-http.service qwen38-coder.service fasth3-v2.service

[Service]
Type=exec
WorkingDirectory=/home/ubuntu/workspace/xenoamess_bake_videos
ExecStartPre=-/usr/bin/systemctl --user reset-failed llmlab-fasth3-omni-bf16-worker.service
ExecStart=/home/ubuntu/workspace/xenoamess_bake_videos/llm-lab/.venv/bin/python /home/ubuntu/workspace/xenoamess_bake_videos/llm-lab/scripts/run_isolated.py --unit llmlab-fasth3-omni-bf16-worker --memory-gib 80 --wait -- /home/ubuntu/workspace/xenoamess_bake_videos/start-fasth3-omni-bf16.sh
ExecStop=-/usr/bin/systemctl --user stop llmlab-fasth3-omni-bf16-worker.service
MemoryMax=256M
MemorySwapMax=0
Restart=no
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
