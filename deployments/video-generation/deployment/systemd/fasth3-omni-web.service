[Unit]
Description=FastH3 Omni Gradio LAN interface
After=fasth3-omni.service network-online.target
Wants=fasth3-omni.service

[Service]
Type=exec
WorkingDirectory=/home/ubuntu/workspace/xenoamess_bake_videos
ExecStart=/home/ubuntu/workspace/xenoamess_bake_videos/start-fasth3-omni-web.sh
MemoryMax=2G
MemorySwapMax=0
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
