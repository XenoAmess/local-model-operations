+    def _precomputed_timestep_subset(self, temb: torch.Tensor) -> torch.Tensor | None:
+        """Reuse exact projection rows when a request omits a reference modality.
+
+        The projection acts independently on each unique timestep. A table
+        recorded with reference audio includes its fixed conditioning timestep;
+        image-only requests omit that row but use the same trained ladder.
+        Require exact timestep values and embedding shape/dtype, without rounding
+        or interpolating entries for an unseen timestep.
+        """
+        if self._cache_key is None:
+            return None
+        timesteps, shape, dtype = self._cache_key
+        if shape != tuple(temb.shape) or dtype != str(temb.dtype) or len(timesteps) != shape[0]:
+            return None
+        for (source_timesteps, source_shape, source_dtype), value in self._modulation_cache.items():
+            if (source_shape[1:] != shape[1:] or source_dtype != dtype
+                    or value.ndim != 2 or value.shape[0] != len(source_timesteps)):
+                continue
+            try:
+                rows = [source_timesteps.index(timestep) for timestep in timesteps]
+            except ValueError:
+                continue
+            indices = torch.tensor(rows, device=value.device, dtype=torch.long)
+            return value.index_select(0, indices)
+        return None
