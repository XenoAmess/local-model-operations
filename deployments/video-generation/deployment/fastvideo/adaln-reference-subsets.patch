@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Reference modality subsets must reuse the checkpoint's exact AdaLN rows."""
+import pytest
+import torch
+import torch.nn.functional as F
+
+from fastvideo.models.dits.minimax_h3 import MiniMaxH3AdaLayerNormModulation
+
+
+def _layer():
+    layer = MiniMaxH3AdaLayerNormModulation.__new__(MiniMaxH3AdaLayerNormModulation)
+    torch.nn.Module.__init__(layer)
+    layer.hidden_size = 2
+    layer.apply_silu = True
+    layer.linear = torch.nn.Linear(4, 36)
+    times = (0.0009999871253967285, 0.9990000128746033, 1.0)
+    inputs = torch.tensor([[t, t * t, t * t * t, 1.0] for t in times])
+    with torch.no_grad():
+        outputs = F.linear(F.silu(inputs), layer.linear.weight, layer.linear.bias)
+    source_key = (times, tuple(inputs.shape), str(inputs.dtype))
+    layer.enable_host_cache({source_key: outputs})
+    return layer, inputs, outputs, source_key
+
+
+@pytest.mark.parametrize("rows", [(0, 1), (1, 0), (0, 2), (2, )])
+def test_reference_subsets_and_order_reuse_exact_rows(rows):
+    layer, inputs, outputs, key = _layer()
+    selected = inputs[list(rows)]
+    layer._cache_key = (tuple(key[0][i] for i in rows), tuple(selected.shape), key[2])
+    result = torch.cat(layer(selected), dim=-1)
+    expected = outputs[list(rows)].view(-1, 12)
+    assert torch.equal(result, expected)
+    assert torch.equal(layer._modulation_cache[layer._cache_key], outputs[list(rows)])
+    assert torch.equal(torch.cat(layer(selected), dim=-1), expected)
+
+
+def test_full_modality_cache_stays_unchanged():
+    layer, inputs, outputs, key = _layer()
+    layer._cache_key = key
+    before = layer._modulation_cache[key]
+    assert torch.equal(torch.cat(layer(inputs), dim=-1), outputs.view(-1, 12))
+    assert layer._modulation_cache[key] is before
+
+
+@pytest.mark.parametrize("kind", ["unseen_timestep", "nearby_timestep", "wrong_dtype", "wrong_width"])
+def test_unsupported_times_and_embedding_contracts_still_fail(kind):
+    layer, inputs, _, key = _layer()
+    selected = inputs[:2]
+    times = key[0][:2]
+    if kind == "unseen_timestep":
+        times = (0.25, times[1])
+    elif kind == "nearby_timestep":
+        times = (times[0] + 1e-10, times[1])
+    elif kind == "wrong_dtype":
+        selected = selected.double()
+    elif kind == "wrong_width":
+        selected = selected[:, :3]
+    layer._cache_key = (times, tuple(selected.shape), str(selected.dtype))
+    with pytest.raises(RuntimeError, match="No precomputed AdaLN"):
+        layer(selected)
