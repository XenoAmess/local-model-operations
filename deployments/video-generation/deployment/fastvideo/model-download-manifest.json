  "selection_reason": "Official FastVideo-format NVFP4 QAD checkpoint for reference-conditioned image/text/video generation on the local Blackwell sm_120 GPU.",
  "intended_pipeline": "MiniMaxH3Ref2VAModularPipeline",
  "input_modes": [
    "text prompt plus ordered image references",
    "text prompt plus ordered video references",
    "mixed ordered image/video references",
    "optional audio references"
  ],
  "components": {
    "transformer_ref": "Reference-conditioned PDD generator, including NVFP4 packed weights and the complete AdaLN weights.",
    "text_encoder": "NVFP4 Qwen3-VL text and vision encoder; exact official weight hashes match existing local files.",
    "processor_and_tokenizer": "Text/image/video input preparation.",
    "vae": "Complete video VAE; includes the encoder needed to read image and video references.",
    "audio_vae": "Audio encoding and decoding, including reference-video audio.",
    "vae_decoder_nvfp4": "36-layer quality decoder.",
    "vae_decoder_nvfp4_fast": "8-layer faster decoder.",
    "scheduler_and_inference_contract": "PDD sampling contract: eight fused forwards; ref2va, VSA 0.9, tile 128."
  },
  "download_only_notes": [
    "No service startup, model load, GPU initialization, tensor conversion or inference is part of this preparation.",
    "The repository includes all shared components; no separate unquantized MiniMax-H3 snapshot is required for the downloaded local component set.",
    "No Omni-specific precomputed AdaLN table is shipped in this pinned repository. The complete projection weights are downloaded; any table generation is deferred until a future deployment task.",
    "The existing FastH3 V2 AdaLN table and its nine-point DMD schedule must not be reused for this eight-block PDD model.",
    "GPU memory, runtime compatibility and generated quality have not been tested for Omni on this machine."
  ]
}
